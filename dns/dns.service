[Unit]
Description=Porkbun dynamic DNS updater
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=porkbun-ddns
LoadCredential=apikey:/etc/porkbun-ddns/apikey
LoadCredential=secretapikey:/etc/porkbun-ddns/secretapikey
LoadCredential=pulse_url:/etc/porkbun-ddns/pulse_url
ExecStart=/usr/local/bin/dns.sh
TimeoutStartSec=300

# Script state lives under /var/lib/porkbun-ddns (managed by StateDirectory).
# Credentials are injected via LoadCredential
ProtectSystem=strict
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6
MemoryDenyWriteExecute=true
